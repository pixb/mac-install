.DS_Store
__pycache__/
*.pyc

# herdr 运行态（只保留 config.toml / .plugins.lock）
herdr/.config/herdr/*.log
herdr/.config/herdr/session.json
herdr/.config/herdr/session-snapshots/

# gnupg 运行时文件（不应入库）
gnupg/.gnupg/trustdb.gpg
gnupg/.gnupg/random_seed
gnupg/.gnupg/public-keys.d/
gnupg/.gnupg/private-keys-v1.d/
gnupg/.gnupg/openpgp-revocs.d/
gnupg/.gnupg/S.*
gnupg/.gnupg/.#*
gnupg/.gnupg/*.lock
