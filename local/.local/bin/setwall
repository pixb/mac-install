#!/usr/bin/env bash
set -euo pipefail

[ "$#" -eq 1 ] || { echo "usage: setwall FILE" >&2; exit 1; }
[ -e "$1" ] || { echo "no such file: $1" >&2; exit 1; }

file="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
mkdir -p "$HOME/.local/share"
ln -sfn "$file" "$HOME/.local/share/wallpaper"
/usr/bin/osascript -e "tell application \"System Events\" to set picture of every desktop to (POSIX file \"$file\")"
