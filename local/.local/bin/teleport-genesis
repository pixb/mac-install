#!/usr/bin/env bash
set -euo pipefail

CONF="${HOME}/.config/shell/teleport.conf"
SHELL_OUT="${HOME}/.config/shell/teleport.sh"
LF_OUT="${HOME}/.config/lf/teleport.conf"

header() { printf '# auto generated by teleport-genesis\n'; }

parse_entries() {
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    key=${line%%=*}
    dir=${line#*=\"}
    dir=${dir%\"}
    printf '%s\t%s\n' "$key" "$dir"
  done < "$CONF"
}

gen_shell() {
  { header; parse_entries | while IFS=$'\t' read -r key dir; do printf 'alias %s="%s"\n' "$key" "$dir"; done; } > "$SHELL_OUT"
  echo "generated $SHELL_OUT"
}

gen_lf() {
  { header; parse_entries | while IFS=$'\t' read -r key dir; do printf 'map %s cd %s\n' "$key" "$dir"; done; } > "$LF_OUT"
  echo "generated $LF_OUT"
}

[ -f "$CONF" ] || { echo "error: $CONF not found" >&2; exit 1; }

case "${1:--a}" in
  -h|--help) printf 'usage: teleport-genesis [-b|--bash] [-l|--lf] [-a|--all]\n' ;;
  -b|--bash) gen_shell ;;
  -l|--lf) gen_lf ;;
  -a|--all) gen_shell; gen_lf ;;
  *) echo "invalid option" >&2; exit 1 ;;
esac
