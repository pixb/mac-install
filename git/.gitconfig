[user]
	email = tpxsky@163.com
	name = pix
[core]
	editor = vim
	whitespace = fix, -indent-with-non-tab, trailing-space, cr-at-eol
	excludesfile=~/.gitignore_global
	autocrlf = input
[init]
	defaultBranch = main
[alias]
    rm="rebase main"
    dc="diff --cached"
    dm="diff main"
    s="status -s"
    cm="commit -m"
    po="push origin"
    pom="push origin main"
    rebase2="rebase -i HEAD~~"
    lg = log --graph --all --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(bold white)— %an%C(reset)%C(bold yellow)%d%C(reset)' --abbrev-commit --date=relative
    co="clone"
    a="add"
[color]
	ui = auto
[color "branch"]
	current = yellow bold
	local = green bold
	remote = cyan bold
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
	whitespace = red reverse
[color "status"]
	added = green bold
	changed = yellow bold
	untracked = red bold
[diff]
	tool = nvimdiff
[difftool]
	prompt = false
[merge]
  ; tool = diffmerge
  tool = nvimdiff
# [mergetool "diffmerge"]
#   cmd = diffmerge "$BASE" "$LOCAL" "$REMOTE" "$MERGED"
[mergetool "nvimdiff"]
  cmd = nvim -d $LOCAL $BASE $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'
# [includeIf "gitdir:~/dev/linux-demo/git/"]
# 	path = ~/dev/linux-demo/git/.gitconfig
[commit]
	template = ~/.gitmessage
	
[http]
	postBuffer = 524288000
[safe]
	directory = /work/docker/docker-prometheus
	directory = *
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
